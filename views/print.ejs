<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= campaign.name %> QR</title><link rel="stylesheet" href="/assets/app.css"></head><body class="print-body"><main class="poster"><p class="eyebrow">INSTANT HOTSPOT ACCESS</p><h1>Scan to connect</h1><p class="poster-name"><%= campaign.name %></p><div class="poster-qr"><img src="<%= qrUrl %>" alt="QR"></div><h2>Connect to Wi‑Fi, then scan this QR</h2><p>One scan automatically requests one available hotspot voucher for your device.</p><p class="tiny mono"><%= publicUrl %></p><button class="btn primary no-print" onclick="window.print()">Print</button></main></body></html>
